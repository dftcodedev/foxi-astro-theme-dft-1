---
// FAQ with sticky sidebar
// ------------
// Description: an FAQ section with the title as a sticky sidebar.

// Components
// - UI
import StickySidebar from '../basic/StickySidebar.astro'
import FAQ from '../../ui/Accordion.astro'
import Card from '../../ui/cards/partials/Card.astro'

// Props
type Props = {
	title: string
	text?: string
	data: any
	type?: 'left' | 'right'
	classes?: string
}
const { title, text, data, type = 'left', classes } = Astro.props
---

<StickySidebar classes={classes} type={type}>
	<header slot="sidebar">
		{title && <h3 class="text-3xl"><svg class="inline-block size-7 mr-2 -mt-0.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>{title}</h3>}
		{text && <p class="text-lg leading-relaxed">{text}</p>}
	</header>

	<Card classes="divide-y divide-neutral-100 dark:divide-neutral-800">
		{data.map((faq: any) => <FAQ title={faq.question} text={faq.reply} open={faq.open} />)}
	</Card>
</StickySidebar>
