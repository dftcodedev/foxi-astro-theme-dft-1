---
// Home page CTA Section
// ------------
// Description: A centered call to action section that contains: a title, text, a user review snippet, a button and a image.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import ChipNotification from '../../ui/ChipNotification.astro'
import Button from '../../ui/Button.astro'
---

<Section id="intro" padding="top" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="2" />
		<Col span="8" align="center">
			<ChipNotification radius="rounded-full" classes="mb-6">
				Growth Agency for <strong>LearnTech</strong> Companies
			</ChipNotification>
			<h1>Help Your LearnTech Company <strong>Reach</strong> the Right Customers</h1>

			<p class="pb-0 text-lg">Strategic growth services for learntech companies seeking to connect with educational institutions and organizations</p>
			<Button size="lg" link="/contact">Get in Touch</Button>
		</Col>
		<Col span="2" />
	</Row>
</Section>
