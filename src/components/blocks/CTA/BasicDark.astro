---
// Basic Dark Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, background image, notification and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import ChipNotification from '../../ui/ChipNotification.astro'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="Ready to Accelerate Your Growth?"
				text="Let's discuss how we can help your learntech company reach more customers and achieve sustainable growth. Get in touch to start the conversation."
				mode="dark"
			>
				<ChipNotification radius="rounded-full" classes="mb-6 box">
					<span>Growth Agency for LearnTech Companies</span>
				</ChipNotification>
				<Button size="lg" style="primary" link="/contact"> Get in Touch </Button>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
