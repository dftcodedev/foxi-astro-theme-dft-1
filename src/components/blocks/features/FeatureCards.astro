---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Growth Services for <strong>LearnTech</strong> Companies</h2>
			<p class="pb-0 text-lg">
				We help learntech companies connect with educational institutions and organizations through strategic positioning, customer acquisition, and content marketing.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Market Positioning"
				subtitle="Define and communicate your unique value in the learntech landscape with clear, compelling positioning."
				image={feature01}
				link="/services/market-positioning"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Customer Acquisition"
				subtitle="Build systematic approaches to reach and convert educational institutions and corporate learning teams."
				image={feature02}
				link="/services/customer-acquisition"
			/>
			<Card
				title="Growth Strategy"
				subtitle="Develop comprehensive roadmaps for sustainable business growth in the learntech market."
				image={feature03}
				link="/services/growth-strategy"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Content Marketing"
				subtitle="Create content that educates, engages, and establishes thought leadership in the learntech space."
				image={feature04}
				link="/services/content-marketing"
			/>
			<Card
				title="Partnerships"
				subtitle="Identify and develop strategic partnerships that expand market reach and create mutual value."
				image={feature05}
				link="/services/partnerships"
			/>
		</Col>
	</Row>
</Section>
