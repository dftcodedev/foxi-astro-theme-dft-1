---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contact information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">How Can We <strong>Help?</strong></h2>
			<p class="pb-0 text-lg">
				Whether you're exploring partnership opportunities, have questions about our services, or want to discuss your growth challenges, we're here to connect.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="New Business Inquiry"
				subtitle="Interested in working with us? Let's discuss how we can help your learntech company grow."
				icon="rocket"
				classes="text-center dark:!bg-neutral-800/50"
				link="#contact"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Partnership Opportunities"
				subtitle="Exploring potential partnerships? Reach out to discuss collaboration opportunities."
				icon="user-group"
				classes="text-center dark:!bg-neutral-800/50"
				link="#contact"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Service Questions"
				subtitle="Have questions about our services or approach? We're happy to provide more information."
				icon="chat-bubble-left-right"
				classes="text-center dark:!bg-neutral-800/50"
				link="#contact"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="General Inquiry"
				subtitle="Not sure where to start? Send us a general inquiry and we'll point you in the right direction."
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="#contact"
			/>
		</Col>
	</Row>
</Section>
