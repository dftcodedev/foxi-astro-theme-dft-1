---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Data
import faqData from '../data/json-files/faqData.json'
// - FAQ Categories
const faqPricing = faqData.filter((faq) => faq.category === 'pricing')
const faqIntegrations = faqData.filter((faq) => faq.category === 'integrations')

// - SEO
const SEO = {
	title: 'FAQ | TheLearnBetter.co',
	description:
		'Find answers to common questions about our growth services for learntech companies, including our approach, engagement process, and how we can help your company grow.'
}
// - Page Header
const header = {
	title: 'Frequently Asked <strong>Questions</strong>',
	text: 'Find answers to common questions about our services and approach.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<FAQ
		title="About Our Services"
		text="Learn about our growth services for learntech companies, including market positioning, customer acquisition, and strategic partnerships."
		data={faqPricing}
	/>
	<Section classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="max-w-4xl mx-auto">
				<h2>Tailored to the <strong>LearnTech</strong> Market</h2>
				<p class="text-lg pb-0">
					We understand the unique challenges of selling to educational institutions and corporate learning organizations. Our strategies are informed by deep market knowledge and designed for practical implementation. We focus on creating sustainable growth through clear positioning, systematic customer acquisition, and strategic partnerships.
				</p>
			</Col>
		</Row>
	</Section>
	<FAQ
		title="Working Together"
		text="Learn about our engagement process, timelines, and how we collaborate with learntech companies to drive growth."
		data={faqIntegrations}
	/>
	<CTA />
</Layout>
