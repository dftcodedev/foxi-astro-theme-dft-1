---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Row from '../../components/ui/Row.astro'
import Col from '../../components/ui/Col.astro'
import Hero from '../../components/blocks/hero/PageHeader.astro'
import CTA from '../../components/blocks/CTA/BasicDark.astro'
import Card from '../../components/ui/cards/BasicCard.astro'

import servicesData from '../../data/json-files/servicesData.json'

const SEO = {
	title: 'Growth Services for LearnTech Companies | TheLearnBetter.co',
	description: 'Comprehensive growth services including market positioning, customer acquisition, growth strategy, content marketing, and partnerships for learntech companies.'
}

const header = {
	title: 'Growth Services for <strong>LearnTech</strong> Companies',
	text: 'We partner with learntech organizations to accelerate growth through strategic positioning, customer acquisition, and market development.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />

	<Section>
		<Row>
			<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
				<h2><svg class="inline-block size-7 mr-2 -mt-0.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>How We Help LearnTech Companies Grow</h2>
				<p class="text-lg">
					Our services are designed specifically for companies in the learntech space, helping you reach educational institutions, corporate learning teams, and organizations seeking innovative learning solutions.
				</p>
			</Col>
		</Row>

		<Row>
			{servicesData.map(service => (
				<Col span="4">
					<Card
						title={service.title}
						subtitle={service.shortDescription}
						link={`/services/${service.slug}`}
					/>
				</Col>
			))}
		</Row>
	</Section>

	<Section classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="max-w-4xl mx-auto">
				<h2><svg class="inline-block size-7 mr-2 -mt-0.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>Our Approach</h2>
				<p class="text-lg">
					We combine deep understanding of the learntech market with proven growth methodologies. Our work is grounded in research, focused on practical execution, and designed to create sustainable growth momentum.
				</p>
			</Col>
		</Row>

		<Row classes="mt-12">
			<Col span="4">
				<h3><svg class="inline-block size-6 mr-1.5 -mt-0.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>Market-Focused</h3>
				<p>We understand the unique dynamics of selling to educational institutions and corporate learning organizations.</p>
			</Col>
			<Col span="4">
				<h3><svg class="inline-block size-6 mr-1.5 -mt-0.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>Practical & Actionable</h3>
				<p>Our strategies are designed for implementation, with clear priorities and realistic timelines.</p>
			</Col>
			<Col span="4">
				<h3><svg class="inline-block size-6 mr-1.5 -mt-0.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>Results-Oriented</h3>
				<p>We focus on outcomes that matter: qualified leads, strategic partnerships, and sustainable growth.</p>
			</Col>
		</Row>
	</Section>

	<CTA />
</Layout>
