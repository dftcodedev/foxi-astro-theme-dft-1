---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Row from '../../components/ui/Row.astro'
import Col from '../../components/ui/Col.astro'
import Hero from '../../components/blocks/hero/PageHeader.astro'
import CTA from '../../components/blocks/CTA/BasicDark.astro'


import servicesData from '../../data/json-files/servicesData.json'
const service = servicesData.find(s => s.slug === 'growth-strategy')

const SEO = {
	title: 'Growth Strategy for LearnTech Companies | TheLearnBetter.co',
	description: 'Develop comprehensive roadmaps for sustainable business growth. Strategic growth planning services for learntech companies.'
}

const header = {
	title: '<strong>Growth Strategy</strong> for LearnTech Companies',
	text: service?.description || ''
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />

	<Section>
		<Row>
			<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
				<h2>Strategic Growth Planning</h2>
				<p class="text-lg">
					Sustainable growth requires clarity on market opportunities, strategic priorities, and execution capabilities. We help learntech companies develop practical strategies that align ambition with reality.
				</p>
			</Col>
		</Row>

		<Row>
			<Col span="6">
				<h3>What We Deliver</h3>
				<ul class="space-y-2 list-disc list-inside">
					{service?.benefits.map(benefit => (
						<li>{benefit}</li>
					))}
				</ul>
			</Col>
			<Col span="6">
				<h3>Our Approach</h3>
				<ul class="space-y-2 list-disc list-inside">
					{service?.approach.map(step => (
						<li>{step}</li>
					))}
				</ul>
			</Col>
		</Row>
	</Section>

	<Section classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="max-w-4xl mx-auto">
				<h2>Who This Is For</h2>
				<p class="text-lg pb-0">
					Our growth strategy services are designed for learntech companies at inflection points, seeking to scale operations, enter new markets, or optimize their growth approach based on market feedback and organizational capacity.
				</p>
			</Col>
		</Row>
	</Section>

	<CTA />
</Layout>
