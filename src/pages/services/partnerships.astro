---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Row from '../../components/ui/Row.astro'
import Col from '../../components/ui/Col.astro'
import Hero from '../../components/blocks/hero/PageHeader.astro'
import CTA from '../../components/blocks/CTA/BasicDark.astro'


import servicesData from '../../data/json-files/servicesData.json'
const service = servicesData.find(s => s.slug === 'partnerships')

const SEO = {
	title: 'Partnership Development for LearnTech Companies | TheLearnBetter.co',
	description: 'Identify and develop strategic partnerships that accelerate growth. Partnership strategy services for learntech companies.'
}

const header = {
	title: '<strong>Partnership Development</strong> for LearnTech Companies',
	text: service?.description || ''
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />

	<Section>
		<Row>
			<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
				<h2>Strategic Partnership Development</h2>
				<p class="text-lg">
					The right partnerships can accelerate market access, enhance product capabilities, and create mutual value. We help learntech companies identify and develop partnerships that align with growth objectives.
				</p>
			</Col>
		</Row>

		<Row>
			<Col span="6">
				<h3>What We Deliver</h3>
				<ul class="space-y-2 list-disc list-inside">
					{service?.benefits.map(benefit => (
						<li>{benefit}</li>
					))}
				</ul>
			</Col>
			<Col span="6">
				<h3>Our Approach</h3>
				<ul class="space-y-2 list-disc list-inside">
					{service?.approach.map(step => (
						<li>{step}</li>
					))}
				</ul>
			</Col>
		</Row>
	</Section>

	<Section classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="max-w-4xl mx-auto">
				<h2>Who This Is For</h2>
				<p class="text-lg pb-0">
					Our partnership services are designed for learntech companies seeking to expand market reach through strategic relationships with complementary technology providers, educational institutions, distribution partners, or industry organizations.
				</p>
			</Col>
		</Row>
	</Section>

	<CTA />
</Layout>
