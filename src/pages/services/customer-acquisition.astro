---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Row from '../../components/ui/Row.astro'
import Col from '../../components/ui/Col.astro'
import Hero from '../../components/blocks/hero/PageHeader.astro'
import CTA from '../../components/blocks/CTA/BasicDark.astro'


import servicesData from '../../data/json-files/servicesData.json'
const service = servicesData.find(s => s.slug === 'customer-acquisition')

const SEO = {
	title: 'Customer Acquisition for LearnTech Companies | TheLearnBetter.co',
	description: 'Build systematic approaches to reach and convert your ideal customers. Strategic customer acquisition services for learntech companies.'
}

const header = {
	title: '<strong>Customer Acquisition</strong> for LearnTech Companies',
	text: service?.description || ''
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />

	<Section>
		<Row>
			<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
				<h2>Reaching the Right Audiences</h2>
				<p class="text-lg">
					Educational institutions and corporate learning teams have specific needs and decision-making processes. We help you connect with them effectively and build relationships that convert to partnerships.
				</p>
			</Col>
		</Row>

		<Row>
			<Col span="6">
				<h3>What We Deliver</h3>
				<ul class="space-y-2 list-disc list-inside">
					{service?.benefits.map(benefit => (
						<li>{benefit}</li>
					))}
				</ul>
			</Col>
			<Col span="6">
				<h3>Our Approach</h3>
				<ul class="space-y-2 list-disc list-inside">
					{service?.approach.map(step => (
						<li>{step}</li>
					))}
				</ul>
			</Col>
		</Row>
	</Section>

	<Section classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="max-w-4xl mx-auto">
				<h2>Who This Is For</h2>
				<p class="text-lg pb-0">
					Our customer acquisition services are designed for learntech companies seeking to build predictable, scalable approaches to reaching educational institutions, corporate learning teams, and other organizations interested in learning solutions.
				</p>
			</Col>
		</Row>
	</Section>

	<CTA />
</Layout>
