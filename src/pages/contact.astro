---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import FormHero from '../components/blocks/hero/ContactHero.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'

// Content
// - SEO
const SEO = {
	title: 'Contact Us | TheLearnBetter.co',
	description:
		'Get in touch with The Learn Better Company to discuss how we can help your learntech company reach more customers and grow strategically.'
}
// - Page Header
const header = {
	title: 'Let\'s Discuss Your <strong>Growth</strong> Goals',
	text: "Whether you're exploring partnership opportunities or have questions about our services, we're here to help. Reach out to start a conversation."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<CTA />
</Layout>
